# ---------------------------------------------------------------------------
# Phantom Monitor - local configuration
# ---------------------------------------------------------------------------
# Mongo connection (copied from phantom-be/.env - staging Atlas cluster)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=phantomstage

# Collections. Leave the exit-window one empty: the app auto-detects any
# collection holding { type: "exit_window" } documents when it is unset.
COLLECTION_SNAPSHOTS=ekosClientState
COLLECTION_CLOCKIN_LOGS=validateClockInLogs
COLLECTION_EXIT_WINDOWS=

# ---------------------------------------------------------------------------
# Password gate. Set BOTH to switch it on: the browser then asks for them
# itself (HTTP Basic) - there is no login page. Leave either empty and the
# console is open to anyone who can reach it.
#
# There is no sign-out: browsers hold the credentials until the window is
# closed. Changing APP_PASSWORD is what revokes access.
APP_USERNAME=
APP_PASSWORD=

PORT=4310
QUERY_TIMEOUT_MS=25000

